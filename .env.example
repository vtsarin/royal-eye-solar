# Formspree (or any endpoint accepting multipart POST) for the quote form on /contact.
# Without this the form renders and validates, but submitting shows the failure state.
VITE_FORM_ENDPOINT=https://formspree.io/f/your-form-id

# Absolute origin used for canonical and Open Graph URLs.
# Defaults to https://royaleyesolar.com when unset.
VITE_SITE_URL=https://royaleyesolar.com
